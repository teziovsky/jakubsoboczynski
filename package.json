{
  "name": "jakubsoboczynski",
  "version": "2.0.2",
  "type": "module",
  "description": "Jakub Soboczyński Portfolio",
  "homepage": "https://www.jakubsoboczynski.pl/",
  "repository": {
    "type": "git",
    "url": "git@github.com:teziovsky/jakubsoboczynski.git"
  },
  "engines": {
    "node": ">=v18.0.0",
    "npm": ">=v8.0.0"
  },
  "bugs": {
    "url": "https://github.com/teziovsky/jakubsoboczynski/issues",
    "email": "teziovsky@gmail.com"
  },
  "author": {
    "name": "Jakub Soboczyński",
    "email": "kontakt@jakubsoboczynski.pl",
    "url": "https://www.jakubsoboczynski.pl"
  },
  "scripts": {
    "clean": "rm -rf ./.astro ./dist ./node_modules ./package-lock.json ./pnpm-lock.yaml ./bun.lockb",
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write --log-level warn '**/*.{js,jsx,ts,tsx,md,mdx,json,astro}'",
    "lint": "eslint --quiet --fix .",
    "typecheck": "astro check",
    "fix": "npm run format && npm run lint && npm run typecheck",
    "astro": "astro",
    "lighthouse": "bunx unlighthouse --site localhost:3000",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "update:project-screenshots": "node scripts/update-project-screenshots.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --quiet --fix"
    ],
    "*.{js,jsx,ts,tsx,md,mdx,json,astro,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.12",
    "@iconify-json/lucide": "^1.2.136",
    "@iconify-json/tabler": "^1.2.40",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-capo": "^0.0.1",
    "astro-icon": "^1.2.0",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "astro-compress": "^2.4.3",
    "astro-eslint-parser": "^3.2.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.140.0"
  }
}
