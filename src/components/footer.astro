---
import { defaultLang, languages } from "@/i18n/ui";
import { getLang, useTranslations } from "@/i18n/utils";
import { focusRing, hoverSquare } from "@/lib/tailwind";
import { cn, directionByIndex } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const { url } = Astro;
const lang = getLang(url);
const t = useTranslations(lang);

const { pathname } = url;

const socialLinks = await getCollection("social-link", ({ id }) => id.startsWith(lang));
const socialLinksSorted = socialLinks.sort((a, b) => a.data.sort - b.data.sort);
---

<footer class="flex flex-col items-center justify-center gap-3 sm:col-span-2 sm:flex-row sm:justify-between">
  <p class="text-sm">2023 &copy; Jakub Soboczyński</p>
  <ul class="flex gap-3">
    {Object.keys(languages).map((language, index) => (
      <li>
        <a
          class={cn(
            "flex h-11 w-11 items-center justify-center rounded-lg transition",
            hoverSquare(directionByIndex(index)),
            {
              "before:translate-x-0 before:translate-y-0 before:scale-100": lang === language,
            },
            focusRing,
          )}
          href={(() => {
            if (language === defaultLang) {
              const stripped = pathname.replace(`/${lang}`, "") || "/";
              return stripped === "/" ? "/" : stripped.endsWith("/") ? stripped : `${stripped}/`;
            }

            if (pathname.startsWith(`/${lang}`)) {
              return pathname.replace(`/${lang}`, `/${language}`);
            }

            return pathname === "/" ? `/${language}/` : `/${language}${pathname}`;
          })()}
          aria-label={language}
        >
          {language.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
  <div class="flex flex-col items-center gap-2 sm:items-end">
    <p class="text-sm font-medium">{t("footer.contact")}</p>
    <ul class="flex gap-3">
      {socialLinksSorted.map(({ data: socialLink }, index) => (
        <li>
          <a
            class={cn(
              "flex h-11 w-11 items-center justify-center rounded-lg transition",
              hoverSquare(directionByIndex(index)),
              focusRing,
            )}
            href={socialLink.link}
            target={socialLink.newTab ? "_blank" : "_self"}
            aria-label={socialLink.alt}
          >
            <Icon name={socialLink.icon} class="h-5 w-5 sm:h-6 sm:w-6" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
