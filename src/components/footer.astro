---
import { defaultLang, languages } from "@/i18n/ui";
import { getLang, useTranslations } from "@/i18n/utils";
import { focusRing } from "@/lib/tailwind";
import { cn } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const { url } = Astro;
const lang = getLang(url);
const t = useTranslations(lang);

const { pathname } = url;

const socialLinks = await getCollection("social-link", ({ id }) => id.startsWith(lang));
const socialLinksSorted = socialLinks.sort((a, b) => a.data.sort - b.data.sort);
---

<footer
  data-show="normal"
  class="flex flex-col items-center justify-center gap-3 border-t border-slate-800 pt-4 font-mono text-slate-400 sm:col-span-2 sm:flex-row sm:justify-between"
>
  <p class="text-sm text-emerald-200/80">2023 &copy; Jakub Soboczyński</p>
  <ul class="flex gap-3">
    {Object.keys(languages).map((language) => (
      <li>
        <a
          class={cn(
            focusRing,
            "flex h-11 w-11 items-center justify-center border text-emerald-200 transition hover:border-emerald-600 hover:text-amber-200",
            lang === language ? "border-amber-400 text-amber-200" : "border-slate-700",
          )}
          href={(() => {
            if (language === defaultLang) {
              const stripped = pathname.replace(`/${lang}`, "") || "/";
              return stripped === "/" ? "/" : stripped.endsWith("/") ? stripped : `${stripped}/`;
            }

            if (pathname.startsWith(`/${lang}`)) {
              return pathname.replace(`/${lang}`, `/${language}`);
            }

            return pathname === "/" ? `/${language}/` : `/${language}${pathname}`;
          })()}
          aria-label={language}
        >
          {language.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
  <div class="flex flex-col items-center gap-2 sm:items-end">
    <p class="text-sm font-medium">{t("footer.contact")}</p>
    <ul class="flex gap-3">
      {socialLinksSorted.map(({ data: socialLink }) => (
        <li>
          <a
            class={cn(
              focusRing,
              "flex h-11 w-11 items-center justify-center border border-slate-700 text-emerald-200 transition hover:border-emerald-600 hover:text-amber-200",
            )}
            href={socialLink.link}
            target={socialLink.newTab ? "_blank" : "_self"}
            aria-label={socialLink.alt}
          >
            <Icon name={socialLink.icon} class="h-5 w-5 sm:h-6 sm:w-6" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
