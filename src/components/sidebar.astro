---
import { getLang, getLocalizedPath, useTranslations } from "@/i18n/utils";
import { focusRing, hoverSquare } from "@/lib/tailwind";
import { cn, directionByIndex } from "@/lib/utils";
import { Icon } from "astro-icon/components";

const { url } = Astro;
const lang = getLang(url);
const t = useTranslations(lang);

const { pathname } = url;

const homeHref = getLocalizedPath("/", lang);

const links = [
  {
    title: t("sidebar.homepage"),
    href: "/",
  },
  {
    title: t("sidebar.about-me"),
    href: "/o-mnie/",
  },
  {
    title: t("sidebar.projects"),
    href: "/projekty/",
  },
  {
    title: t("sidebar.uses"),
    href: "/uses/",
  },
].map(({ title, href }) => {
  const localizedHref = getLocalizedPath(href, lang);
  const path = pathname.endsWith("/") ? pathname : `${pathname}/`;
  const target = localizedHref.endsWith("/") ? localizedHref : `${localizedHref}/`;
  const isCurrent = href === "/" ? path === target : path === target || path.startsWith(target);

  return { title, href: localizedHref, isCurrent };
});

/**
 * Returns the CSS classes for a link based on its index and active state.
 */
function handleLinkClass(index: number, isCurrent: boolean) {
  const baseClasses = "inline-flex min-h-11 items-center rounded-lg px-3 py-2 transition";
  const currentClasses = isCurrent ? "bg-slate-200 dark:bg-slate-800 hocus:before:scale-0" : "";

  return cn(baseClasses, hoverSquare(directionByIndex(index)), focusRing, currentClasses);
}
---

<aside class="w-full sm:sticky sm:top-4">
  <nav class="flex flex-wrap items-center justify-between gap-3 sm:flex-col sm:items-start">
    <a class={cn(focusRing, "self-center rounded-lg px-3 py-1.5")} href={homeHref} aria-label={t("sidebar.homepage")}>
      <Icon name="logo" class="h-12 w-12 sm:h-14 sm:w-14" />
    </a>
    <ul class="mx-auto flex gap-3 sm:flex-col sm:gap-2">
      {links.map(({ title, href, isCurrent }, index) => (
        <li class="flex justify-center">
          <a class={handleLinkClass(index, isCurrent)} aria-current={isCurrent ? "page" : undefined} href={href}>
            {title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
