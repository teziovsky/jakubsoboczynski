---
import { SEO } from "astro-seo";
import { Head } from "astro-capo";
import Footer from "@/components/footer.astro";
import Sidebar from "@/components/sidebar.astro";
import { ClientRouter } from "astro:transitions";
import { getLang, getLanguageAlternates } from "@/i18n/utils";
import "@/global.css";

export type Props = {
  title: string;
  titleTemplate?: string;
  description: string;
  image: string;
  isWide?: boolean;
  compact?: boolean;
};

const {
  title,
  titleTemplate = "%s | Jakub Soboczyński",
  description,
  image,
  isWide = false,
  compact = false,
} = Astro.props;

const { url } = Astro;
const lang = getLang(url);

const { pathname } = url;

const canonicalURL = new URL(pathname, Astro.site);
const absoluteImage = new URL(image, Astro.site).href;
const fullTitle = titleTemplate.replace(/%s/g, title);
const languageAlternates = getLanguageAlternates(pathname, Astro.site);
const ogLocale = lang === "pl" ? "pl_PL" : "en_US";
const ogLocaleAlternate = lang === "pl" ? "en_US" : "pl_PL";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://jakubsoboczynski.pl/#website",
      url: "https://jakubsoboczynski.pl/",
      name: "Jakub Soboczyński",
      inLanguage: ["pl", "en"],
      publisher: { "@id": "https://jakubsoboczynski.pl/#person" },
    },
    {
      "@type": "Person",
      "@id": "https://jakubsoboczynski.pl/#person",
      name: "Jakub Soboczyński",
      url: "https://jakubsoboczynski.pl/",
      email: "kontakt@jakubsoboczynski.pl",
      jobTitle: "Frontend Developer",
      sameAs: ["https://github.com/teziovsky", "https://x.com/teziovsky/", "https://linkedin.com/in/jakubsoboczynski/"],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: fullTitle,
      description,
      isPartOf: { "@id": "https://jakubsoboczynski.pl/#website" },
      about: { "@id": "https://jakubsoboczynski.pl/#person" },
      inLanguage: lang,
    },
  ],
};
---

<!doctype html>
<html transition:animate="none" lang={lang} data-layout="terminal">
  <Head>
    <script is:inline>
      (function () {
        var key = "site-layout";
        function readLayout() {
          try {
            var stored = localStorage.getItem(key);
            if (stored === "normal" || stored === "terminal") return stored;
          } catch (e) {}
          return "terminal";
        }
        function applyLayout() {
          document.documentElement.dataset.layout = readLayout();
        }
        applyLayout();
        if (!window.__siteLayoutBound) {
          window.__siteLayoutBound = true;
          document.addEventListener("astro:after-swap", applyLayout);
        }
      })();
    </script>
    <script
      is:inline
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-HNBWJKKETF"
    ></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-HNBWJKKETF");
    </script>
    <SEO
      canonical={canonicalURL.href}
      charset="UTF-8"
      description={description}
      languageAlternates={languageAlternates}
      openGraph={{
        basic: {
          title: fullTitle,
          type: "website",
          url: canonicalURL.href,
          image: absoluteImage,
        },
        optional: {
          description,
          locale: ogLocale,
          localeAlternate: [ogLocaleAlternate],
          siteName: "Jakub Soboczyński",
        },
        image: {
          alt: "Jakub Soboczyński",
        },
      }}
      title={title}
      titleTemplate={titleTemplate}
      twitter={{
        card: "summary_large_image",
        title: fullTitle,
        description: description,
        image: absoluteImage,
        creator: "@teziovsky",
      }}
      extend={{
        meta: [
          {
            name: "viewport",
            content: "width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content",
          },
          {
            name: "generator",
            content: Astro.generator,
          },
        ],
        link: [
          {
            rel: "icon",
            type: "image/svg+xml",
            media: "(prefers-color-scheme: dark)",
            href: "/favicon-dark.svg",
          },
          {
            rel: "icon",
            type: "image/svg+xml",
            media: "(prefers-color-scheme: light)",
            href: "/favicon-light.svg",
          },
          {
            rel: "sitemap",
            href: "/sitemap-index.xml",
          },
        ],
      }}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <ClientRouter />
  </Head>

  <body
    class:list={[
      "grid-rows-mobile sm:grid-cols-sidebar sm:grid-rows-desktop container grid min-h-dvh items-start overflow-x-clip bg-slate-950 font-mono text-emerald-50 antialiased sm:gap-6 sm:pt-8 sm:pb-8 md:gap-8",
      compact ? "gap-3 py-3" : "gap-12 py-4",
      { "max-w-4xl": !isWide },
    ]}
  >
    <Sidebar />
    <main class:list={["min-w-0 sm:pt-4", compact ? "pb-3 sm:pb-4" : "pb-8 sm:pb-20"]}>
      <slot />
    </main>
    <Footer />

    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      ::-webkit-scrollbar {
        width: 10px;
      }

      @media (prefers-color-scheme: light) {
        ::-webkit-scrollbar-track {
          background-color: rgb(248 250 252 / var(--tw-bg-opacity));
          border-left: 1px solid rgb(226 232 240 / var(--tw-bg-opacity));
        }

        ::-webkit-scrollbar-thumb {
          background-color: rgb(226 232 240 / var(--tw-bg-opacity));
        }

        ::-webkit-scrollbar-thumb:hover {
          background-color: rgb(203 213 225 / var(--tw-bg-opacity));
        }
      }

      @media (prefers-color-scheme: dark) {
        ::-webkit-scrollbar-track {
          background-color: rgb(2 6 23 / var(--tw-bg-opacity));
          border-left: 1px solid rgb(30 41 59 / var(--tw-text-opacity));
        }

        ::-webkit-scrollbar-thumb {
          background-color: rgb(30 41 59 / var(--tw-bg-opacity));
        }

        ::-webkit-scrollbar-thumb:hover {
          background-color: rgb(51 65 85 / var(--tw-bg-opacity));
        }
      }

      .scrollbar-hidden {
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .scrollbar-hidden::-webkit-scrollbar {
        display: none;
      }

      .prose :where(ul > li > p):not(:where([class~="not-prose"] *)) {
        margin-top: 0;
        margin-bottom: 0;
      }
    </style>
  </body>
</html>
