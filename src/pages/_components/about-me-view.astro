---
import { getLang, useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/layout.astro";
import { proseArticle } from "@/lib/tailwind";
import { getEntry, render } from "astro:content";

const { url } = Astro;
const lang = getLang(url);
const t = useTranslations(lang);

const aboutMe = await getEntry("about-me", `${lang}/o-mnie`);

if (!aboutMe) {
  return Astro.redirect("/404");
}

const { Content } = await render(aboutMe);
---

<Layout title={t("about-me.seo.title")} description={t("about-me.seo.description")} image="/og_image.png">
  <article class:list={["doc-panel", proseArticle]}>
    <p data-show="terminal" class="mb-3 font-mono text-sm text-emerald-300">
      ~/about
    </p>
    <h1 transition:name="routeHeading">Jakub Soboczyński</h1>
    <Content />
  </article>
</Layout>
