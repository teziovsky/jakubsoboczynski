---
import { cn } from "cn";

import ProjectFacts from "@/components/project-facts.astro";
import { getLang, getLocalizedPath, useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/layout.astro";
import { getProject } from "@/lib/projects";
import { focusRing } from "@/lib/tailwind";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const project = await getProject(lang, slug);

if (!project) {
  return Astro.redirect("/404");
}

const projectsHref = getLocalizedPath("/projekty/", lang);
const homeHref = getLocalizedPath("/", lang);
const description = project.summary?.slice(0, 180) || t("projects.seo.description");
const linkClass = cn(
  focusRing,
  "inline-flex min-h-12 items-center justify-center border px-4 text-center font-mono text-sm transition",
);
---

<Layout title={project.name} description={description} image="/og_image.png">
  <article class="project-page min-w-0 overflow-x-clip" data-project={project.name}>
    <nav
      data-show="normal"
      class="project-nav flex flex-col gap-2 sm:flex-row sm:flex-wrap"
      aria-label={t("project.nav")}
    >
      <a class={cn(linkClass, "border-slate-600 bg-slate-950 text-sky-200")} href={homeHref}>
        {t("project.back-terminal")}
      </a>
      <a class={cn(linkClass, "border-slate-600 bg-slate-950 text-sky-200")} href={projectsHref}>
        {t("project.back")}
      </a>
    </nav>
    <header class="project-lead flex flex-col gap-3">
      <h1 transition:name="routeHeading" class="font-mono text-3xl break-words text-amber-100 sm:text-4xl">
        {project.name}
      </h1>
      {project.summary && <p class="text-base leading-7 break-words text-emerald-100/90">{project.summary}</p>}
      {project.intro && (
        <p class="text-base leading-7 break-words whitespace-pre-wrap text-emerald-100/80">{project.intro}</p>
      )}
    </header>
    <div class="project-side">
      <ProjectFacts project={project} />
    </div>
    <div class="project-actions flex flex-col gap-2 sm:flex-row sm:flex-wrap">
      {project.htmlUrl && (
        <a
          class={cn(linkClass, "border-emerald-700 bg-emerald-950 text-emerald-50")}
          href={project.htmlUrl}
          target="_blank"
          rel="noreferrer noopener"
        >
          {t("projects.repository")}
        </a>
      )}
      {project.homepage && (
        <a
          class={cn(linkClass, "border-slate-600 bg-slate-950 text-sky-200")}
          href={project.homepage}
          target="_blank"
          rel="noreferrer noopener"
        >
          {t("projects.homepage")}
        </a>
      )}
    </div>
  </article>
</Layout>
