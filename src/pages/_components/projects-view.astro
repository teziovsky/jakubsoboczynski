---
import { cn } from "cn";

import ProjectFacts from "@/components/project-facts.astro";
import { getLang, useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/layout.astro";
import { getProjects } from "@/lib/projects";
import { focusRing } from "@/lib/tailwind";

const { url } = Astro;
const lang = getLang(url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
const linkClass = cn(
  focusRing,
  "inline-flex min-h-12 items-center justify-center border px-4 text-center font-mono text-sm transition",
);
---

<Layout title={t("projects.seo.title")} description={t("projects.seo.description")} image="/og_image.png" isWide>
  <article class="min-w-0">
    <h1 transition:name="routeHeading" class="mb-4 font-mono text-3xl break-words text-amber-100 sm:text-4xl">
      {t("projects.title")}
    </h1>
    <p class="mb-7 max-w-3xl font-mono text-base leading-7 text-emerald-100/90">{t("projects.lead")}</p>
    <ul class="project-list m-0 list-none p-0">
      {projects.map((project) => (
        <li class="project-card m-0 min-w-0">
          <h2 class="project-card-title font-mono text-xl break-words text-amber-100">
            <a class={cn(focusRing, "rounded-sm")} href={project.href}>
              {project.name}
            </a>
          </h2>
          {project.summary && (
            <p class="project-card-summary text-sm leading-6 break-words text-emerald-100/80">{project.summary}</p>
          )}
          <div class="project-card-facts">
            <ProjectFacts project={project} />
          </div>
          <div class="project-card-actions">
            <a class={cn(linkClass, "border-emerald-700 bg-emerald-950 text-emerald-50")} href={project.href}>
              {t("projects.read-more")}
            </a>
            <a
              class={cn(linkClass, "border-slate-600 bg-slate-950 text-sky-200")}
              href={project.htmlUrl}
              target="_blank"
              rel="noreferrer noopener"
            >
              {t("projects.repository")}
            </a>
            {project.homepage && (
              <a
                class={cn(linkClass, "border-slate-600 bg-slate-950 text-sky-200")}
                href={project.homepage}
                target="_blank"
                rel="noreferrer noopener"
              >
                {t("projects.homepage")}
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </article>
</Layout>
